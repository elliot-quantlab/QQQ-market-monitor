# Copy these values into your local environment. Do not commit real credentials.
SMTP_USERNAME=your_sender@qq.com
SMTP_PASSWORD=your_qq_email_authorization_code
RECEIVER_EMAILS=your_receiver@example.com

# Optional settings
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SYMBOL=QQQ
REPORT_TIMEZONE=Asia/Shanghai
DRY_RUN=true
OUTPUT_DIR=output
